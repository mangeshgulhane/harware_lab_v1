# This file configures the backend server.

# --- AI PROVIDER SELECTION ---
# Determines which AI model the backend will use.
# Supported values: "gemini", "openai", "ollama"
# To use OpenAI, you must also set OPENAI_API_KEY.
# To use Ollama, you must also set OLLAMA_BASE_URL and OLLAMA_MODEL.
LLM_PROVIDER="gemini"

# --- Gemini Configuration ---
# Auth mode: "api_key" (AI Studio) or "vertex" (Google Cloud / Vertex AI)
GEMINI_AUTH_MODE="vertex"
# Model to use (e.g., gemini-4-argon, gemini-2.5-flash)
GEMINI_MODEL="gemini-4-argon"

# For api_key mode:
API_KEY="AIzaSyCTfPj4o8sGZmnjabcMXYS4hKMV-NU7d9g"

# For vertex mode:
GOOGLE_CLOUD_PROJECT="adk-bot-485514"
GOOGLE_CLOUD_LOCATION="global"

# --- (Optional) OpenAI Configuration ---
# OPENAI_API_KEY="sk-..."

# --- (Optional) Ollama (Local LLM) Configuration ---
# OLLAMA_BASE_URL="http://localhost:11434/v1"
# OLLAMA_MODEL="llama3"